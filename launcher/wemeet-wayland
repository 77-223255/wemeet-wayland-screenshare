#!/bin/sh
# wemeet-wayland — start Tencent Wemeet so that screen sharing goes through
# xdg-desktop-portal instead of the (empty) XWayland root window.
#
# Derived from AUR wemeet-bin 3.26.10.401-5 /usr/bin/wemeet, with three changes:
#   1. drop bwrap's --unshare-pid: otherwise xdg-desktop-portal cannot resolve
#      the client's credentials and the share request silently dies.
#   2. keep `export WEMEET_XWAYLAND=1`: disassembly of libscreen_share_module.so
#      shows IsUseXDGDesktopPortal() (0x41fac0) is literally
#      `getenv("WEMEET_XWAYLAND") == "1"`, i.e. 1 => use the portal.
#      Unset => legacy X11 XShm capture of an empty XWayland root => black frames.
#   3. bind-mount a Hunk-0-patched libscreen_share_module.so over the stock
#      module inside this process' bwrap namespace only (/opt/wemeet untouched).
#
# The UI stays in X11 mode (XDG_SESSION_TYPE=x11, no WAYLAND_DISPLAY,
# QT_QPA_PLATFORM=xcb). Do NOT set XDG_SESSION_TYPE=wayland while keeping
# QT_QPA_PLATFORM=xcb: that SIGSEGVs in
# x_utils::SetWindowInputFocus -> XSetInputFocus -> _XGetRequest.
#
# Requires: wemeet-bin 3.26.10.401-5, bubblewrap, patched module (install.sh).
set -eu

FIX_LIB="${WEMEET_FIX_LIB:-$HOME/.local/lib/wemeet-fix/libscreen_share_module.so}"
MODULE=/opt/wemeet/bin/modules/screen_share/libscreen_share_module.so

[ -x /opt/wemeet/bin/wemeetapp ] || { echo "未找到腾讯会议：请先安装 wemeet-bin" >&2; exit 1; }
[ -f "$FIX_LIB" ] || { echo "缺少补丁模块 $FIX_LIB（先跑 install.sh）" >&2; exit 1; }
command -v bwrap >/dev/null || { echo "需要 bubblewrap：sudo pacman -S bubblewrap" >&2; exit 1; }

# patch offsets are bound to one upstream build; warn instead of failing silently
ver=$(pacman -Q wemeet-bin 2>/dev/null | awk '{print $2}' || true)
case "${ver:-}" in
    3.26.10.401-*) : ;;
    *) echo "⚠ wemeet-bin 版本为 ${ver:-未知}，本补丁仅针对 3.26.10.401-5" >&2 ;;
esac

export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_STYLE_OVERRIDE=fusion                                       # 自带 Qt 下字体全白的问题
export IBUS_USE_PORTAL=1                                              # fix ibus
export LD_LIBRARY_PATH="/usr/lib/wemeet:${LD_LIBRARY_PATH:-/usr/lib}" # 否则启动失败

USER_RUN_DIR="/run/user/$(id -u)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
FONTCONFIG_DIR="$CONFIG_DIR/fontconfig"
KDE_GLOBALS_FILE="$CONFIG_DIR/kdeglobals"
KDE_ICON_CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/icon-cache.kcache"
WEMEET_APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/wemeetapp"
LD_PRELOAD_WRAP="${LD_PRELOAD:-}:/usr/lib/wemeet/libwemeetwrap.so"    # 缓解传输文件崩溃

if [ "$(basename "$0")" = 'wemeet-wayland-x11' ]; then
    # 强制纯 X11（调试用）
    export XDG_SESSION_TYPE=x11
    export EGL_PLATFORM=x11
    export QT_QPA_PLATFORM=xcb
    unset WAYLAND_DISPLAY
elif [ "$XDG_SESSION_TYPE" = 'wayland' ]; then
    # 与 AUR 原版一致：界面走 X11
    export QT_QPA_PLATFORM=xcb
    export XDG_SESSION_TYPE=x11
    unset WAYLAND_DISPLAY
    # 关键：WEMEET_XWAYLAND=1 才是走 xdg-desktop-portal 的开关
    #   IsUseXDGDesktopPortal() == (getenv("WEMEET_XWAYLAND") == "1")
    export WEMEET_XWAYLAND=1
fi

mkdir -p "$WEMEET_APP_DIR"
exec bwrap \
    --new-session \
    --unshare-user-try --unshare-uts --unshare-cgroup-try \
    --proc /proc \
    --ro-bind / / \
    --dev-bind /dev /dev \
    --bind /tmp /tmp \
    --ro-bind /dev/null /proc/cpuinfo \
    --tmpfs /sys/devices/virtual \
    --bind "$USER_RUN_DIR" "$USER_RUN_DIR" \
    --tmpfs /var \
    --tmpfs "$CONFIG_DIR" \
    --ro-bind-try "$KDE_GLOBALS_FILE" "$KDE_GLOBALS_FILE" \
    --ro-bind-try "$FONTCONFIG_DIR" "$FONTCONFIG_DIR" \
    --bind-try "$KDE_ICON_CACHE_FILE" "$KDE_ICON_CACHE_FILE" \
    --bind "$WEMEET_APP_DIR" "$WEMEET_APP_DIR" \
    --ro-bind "$FIX_LIB" "$MODULE" \
    --setenv LD_PRELOAD "$LD_PRELOAD_WRAP" \
    /opt/wemeet/bin/wemeetapp "$@"
